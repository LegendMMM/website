# Use the pooled Postgres connection string from Neon or your Vercel Marketplace Postgres provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/reconciliation?schema=public"

# Required in production. Use at least 32 random characters.
SESSION_SECRET="replace-with-a-random-32-byte-secret"

# Initial accounts created by npm run db:seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
PARTNER_EMAIL="partner@example.com"
PARTNER_PASSWORD="change-me-too"
